---
import { Image } from 'astro:assets';
import conv1 from '../assets/images/conversation (1).png';
import conv2 from '../assets/images/conversation (2).png';
import conv3 from '../assets/images/conversation (3).png';
---

<section id="testimonios" class="bg-bg py-20 px-12 reveal">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-12">
      <p class="text-[0.72rem] font-semibold tracking-[0.18em] text-light-pink m-0 mb-3 uppercase">TESTIMONIOS REALES</p>
      <h2 class="font-serif text-[clamp(1.8rem,3vw,2.5rem)] font-bold text-dark m-0">
        Clientas que ya lucen radiantes
      </h2>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="rounded-2xl overflow-hidden shadow-[0_4px_20px_rgba(0,0,0,0.1)]">
        <Image src={conv1} alt="Reseña de clienta — WhatsApp" class="w-full block" />
      </div>
      <div class="rounded-2xl overflow-hidden shadow-[0_4px_20px_rgba(0,0,0,0.1)]">
        <Image src={conv2} alt="Reseña de clienta — WhatsApp" class="w-full block" />
      </div>
      <div class="rounded-2xl overflow-hidden shadow-[0_4px_20px_rgba(0,0,0,0.1)]">
        <Image src={conv3} alt="Reseña de clienta — WhatsApp" class="w-full block" />
      </div>
    </div>
  </div>
</section>
