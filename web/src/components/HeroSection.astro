---
import { Image } from 'astro:assets';
import heroImg from '../assets/images/generated-1775198929226.png';
---

<section class="grid grid-cols-[60%_40%] h-[640px] bg-hero-bg max-[1100px]:grid-cols-1 max-[1100px]:h-auto">
  <!-- Left: photo -->
  <div class="relative overflow-hidden h-[640px] max-[1100px]:h-[400px]">
    <Image src={heroImg} alt="Maquillaje profesional Monterrey" class="w-full h-full object-cover block" loading="eager" fetchpriority="high" />
    <!-- Social badge – absolute bottom-left -->
    <div class="absolute bottom-7 left-6 bg-white rounded-[18px] px-4 flex items-center gap-2 h-9 shadow-[0_4px_16px_rgba(0,0,0,0.12)] text-[13px] font-semibold text-dark">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#F5A623" stroke="#F5A623" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      4.9 · +200 clientas felices
    </div>
  </div>

  <!-- Right: content -->
  <div class="flex flex-col justify-center pt-14 pr-12 pb-14 pl-14 gap-5 bg-hero-bg">
    <p class="text-[0.72rem] font-semibold tracking-[0.18em] text-light-pink m-0 uppercase">MAQUILLISTA PROFESIONAL · MONTERREY, NL</p>
    <h1 class="font-serif text-[clamp(2.2rem,3.5vw,3rem)] font-bold text-dark leading-[1.15] m-0">
      Luce increíble<br/>en cada ocasión
    </h1>
    <p class="font-serif italic text-base text-muted-pink m-0 leading-[1.5]">
      "Hacemos brillar tu belleza natural con pasión y profesionalismo."
    </p>
    <p class="text-[0.9rem] text-text/65 leading-[1.7] m-0">
      Maquillaje, secados y paquetes especiales para novias, quinceañeras y looks del día a día. A domicilio en Monterrey.
    </p>
    <a href="#contacto"
      class="flex items-center justify-center bg-primary text-white no-underline h-[54px] rounded-[27px] text-base font-bold tracking-[0.02em] shadow-[0_8px_24px_rgba(224,26,79,0.25)] transition-colors duration-200 hover:bg-[#c01543]">
      Agenda tu cita →
    </a>
    <!-- Trust row -->
    <div class="flex gap-5 flex-wrap">
      <div class="flex items-center gap-[6px] text-[0.82rem] text-[#555]">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E01A4F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
        A domicilio
      </div>
      <div class="flex items-center gap-[6px] text-[0.82rem] text-[#555]">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E01A4F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
        Productos premium
      </div>
      <div class="flex items-center gap-[6px] text-[0.82rem] text-[#555]">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E01A4F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
        3+ años de experiencia
      </div>
    </div>
  </div>
</section>
