---
---

<section class="py-32 bg-primary-container relative overflow-hidden reveal" aria-label="Reserva tu cita">
  <!-- Decorative blobs -->
  <div class="absolute -top-20 -left-20 w-80 h-80 rounded-full bg-on-primary/10 pointer-events-none blur-3xl" aria-hidden="true"></div>
  <div class="absolute -bottom-20 -right-20 w-96 h-96 rounded-full bg-primary/20 pointer-events-none blur-3xl" aria-hidden="true"></div>

  <div class="container mx-auto px-6 relative z-10 text-center">
    <span class="script-font text-5xl text-on-primary/90 mb-6 block" aria-hidden="true">I can't wait to meet you!</span>
    <h2 class="font-headline font-extrabold text-on-primary text-5xl md:text-7xl leading-[1.1] mb-6 m-0">
      Tu transformación empieza aquí
    </h2>
    <p class="text-on-primary/80 font-body text-lg mb-12 max-w-2xl mx-auto">
      Los espacios se agotan rápido — especialmente en temporada de bodas. Asegura tu fecha hoy mismo.
    </p>
    <button
      type="button"
      data-cal-link="francisco-javier-moreno-hinojosa-udolb9/peinado"
      data-cal-namespace="peinado"
      data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}'
      class="bg-on-primary text-primary px-16 py-6 rounded-full font-extrabold text-2xl shadow-2xl hover:scale-105 transition-transform duration-300 font-headline cursor-pointer border-none">
      Reservar Ahora
    </button>

    <div class="flex items-center justify-center gap-3 mt-8 text-on-primary/80">
      <span class="material-symbols-outlined text-lg" aria-hidden="true">schedule</span>
      <span class="font-body text-sm">Respuesta en menos de 24h</span>
    </div>
  </div>

  <!-- Decorative watermark -->
  <span class="script-font text-9xl text-on-primary/20 absolute bottom-10 right-10 select-none hidden lg:block pointer-events-none" aria-hidden="true">Caro Sweet</span>
</section>
