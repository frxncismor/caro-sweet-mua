---
import { Image } from 'astro:assets';
import caroAbout from '../assets/images/caro_3.jpg';
---

<section class="bg-white py-20 px-12 reveal">
  <div class="max-w-7xl mx-auto grid grid-cols-[460px_1fr] gap-16 items-center max-[900px]:grid-cols-1">
    <!-- Left: photo -->
    <div class="relative">
      <div class="rounded-3xl overflow-hidden h-[540px]">
        <Image src={caroAbout} alt="Carolina — Maquillista Profesional Monterrey" class="w-full h-full object-cover block" />
      </div>
      <!-- Badge -->
      <div class="absolute bottom-6 -right-4 bg-hero-bg rounded-full px-5 py-2 flex items-center gap-[0.4rem] shadow-[0_4px_16px_rgba(0,0,0,0.1)] text-[0.8rem] font-semibold text-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#E01A4F" stroke="#E01A4F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        +200 clientas satisfechas
      </div>
    </div>
    <!-- Right: content -->
    <div>
      <p class="text-[0.72rem] font-semibold tracking-[0.18em] text-light-pink m-0 mb-3 uppercase">SOBRE MÍ</p>
      <h2 class="font-serif text-[clamp(1.8rem,3vw,2.4rem)] font-bold text-dark m-0 mb-5">
        ¿Por qué Carolina?
      </h2>
      <p class="text-[0.95rem] text-[#555] leading-[1.8] m-0 mb-7">
        Soy Carolina, maquillista profesional con más de 3 años transformando looks en Monterrey. Me especializo en crear el maquillaje que siempre soñaste: duradero, fotogénico y completamente tuyo. Voy a donde tú estás.
      </p>
      <div class="flex flex-col gap-3 mb-8">
        <div class="flex items-start gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E01A4F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-[2px]" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
          <span class="text-[0.9rem] text-text leading-[1.5]">Técnicas certificadas de maquillaje profesional</span>
        </div>
        <div class="flex items-start gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E01A4F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-[2px]" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
          <span class="text-[0.9rem] text-text leading-[1.5]">Productos de alta gama: MAC, Charlotte Tilbury, NYX</span>
        </div>
        <div class="flex items-start gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E01A4F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-[2px]" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
          <span class="text-[0.9rem] text-text leading-[1.5]">Servicio a domicilio en Monterrey y área metropolitana</span>
        </div>
        <div class="flex items-start gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E01A4F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-[2px]" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
          <span class="text-[0.9rem] text-text leading-[1.5]">Maquillaje duradero y fotogénico, garantizado</span>
        </div>
      </div>
      <a href="https://wa.me/528137459614" target="_blank" rel="noopener"
        class="inline-flex items-center gap-2 bg-dark text-white no-underline px-7 rounded-full text-[0.95rem] font-bold h-[50px] transition-colors duration-200 hover:bg-[#333]">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
        Chatear por WhatsApp
      </a>
    </div>
  </div>
</section>
