---
import { Image } from 'astro:assets';
import caroAbout from '../assets/images/caro_3.jpg';
---

<section id="about" class="py-20 md:py-32 overflow-hidden bg-white">
  <div class="container mx-auto px-6 grid md:grid-cols-2 gap-10 md:gap-20 items-center">
    <!-- Left: photo -->
    <div class="reveal-left">
      <Image
        src={caroAbout}
        alt="Carolina — Makeup & Hair Artist en Monterrey, N.L."
        class="w-full aspect-square object-cover rounded-xl shadow-2xl grayscale-[20%] hover:grayscale-0 transition-all duration-700"
        loading="lazy"
      />
    </div>

    <!-- Right: content -->
    <div class="flex flex-col gap-5 md:gap-6 reveal-right reveal-delay-1">
      <p class="text-[#6E6E6E] font-semibold tracking-widest uppercase text-sm font-label m-0">Sobre Mí</p>
      <h2 class="font-headline font-bold text-on-surface text-[clamp(1.8rem,3vw,2.4rem)] m-0">
        Hola, soy Caro ✨
      </h2>
      <p class="text-[#6E6E6E] font-body text-base leading-relaxed m-0">
        Makeup &amp; hair artist en Monterrey, N.L. Looks naturales y elegantes, pensados para que te sientas tú misma.
      </p>

      <!-- Checklist -->
      <div class="flex flex-col gap-3">
        <div class="flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1C1C1C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
          <span class="text-on-surface font-body text-sm">Productos profesionales</span>
        </div>
        <div class="flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1C1C1C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
          <span class="text-on-surface font-body text-sm">Servicio en Monterrey y área metropolitana</span>
        </div>
        <div class="flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1C1C1C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
          <span class="text-on-surface font-body text-sm">Maquillaje y peinado a domicilio</span>
        </div>
      </div>

      <!-- Quote card -->
      <div class="bg-[#F5F5F5] border border-[#D9D9D9] rounded-xl p-6 relative mt-2">
        <span class="script-font text-4xl text-[#F4CFC9] absolute -top-4 left-6 select-none" aria-hidden="true">CB MUA</span>
        <p class="text-[#6E6E6E] font-body text-sm leading-relaxed m-0 pt-4 italic">
          "Mi enfoque es lograr un look que vaya contigo, cuidando cada detalle para que te sientas segura, cómoda y bonita."
        </p>
      </div>
    </div>
  </div>
</section>
