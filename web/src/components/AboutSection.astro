---
import { Image } from 'astro:assets';
import caroAbout from '../assets/images/caro_3.jpg';
---

<section style="background:white; padding:5rem 3rem;">
  <div style="max-width:1280px; margin:0 auto;" class="about-grid">
    <!-- Left: photo -->
    <div style="position:relative;">
      <div style="border-radius:1.5rem; overflow:hidden; height:540px;">
        <Image src={caroAbout} alt="Carolina — Maquillista Profesional Monterrey" style="width:100%; height:100%; object-fit:cover; display:block;" />
      </div>
      <!-- Badge -->
      <div style="position:absolute; bottom:1.5rem; right:-1rem; background:#FFF0F5; border-radius:9999px; padding:0.5rem 1.25rem; display:flex; align-items:center; gap:0.4rem; box-shadow:0 4px 16px rgba(0,0,0,0.1); font-size:0.8rem; font-weight:600; color:#E01A4F;">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#E01A4F" stroke="#E01A4F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        +200 clientas satisfechas
      </div>
    </div>
    <!-- Right: content -->
    <div>
      <p style="font-size:0.72rem; font-weight:600; letter-spacing:0.18em; color:#E8B4B8; margin:0 0 0.75rem; text-transform:uppercase;">SOBRE MÍ</p>
      <h2 style="font-family:'Playfair Display',serif; font-size:clamp(1.8rem,3vw,2.4rem); font-weight:700; color:#1A1A1A; margin:0 0 1.25rem;">
        ¿Por qué Carolina?
      </h2>
      <p style="font-size:0.95rem; color:#555; line-height:1.8; margin:0 0 1.75rem;">
        Soy Carolina, maquillista profesional con más de 3 años transformando looks en Monterrey. Me especializo en crear el maquillaje que siempre soñaste: duradero, fotogénico y completamente tuyo. Voy a donde tú estás.
      </p>
      <div style="display:flex; flex-direction:column; gap:0.75rem; margin-bottom:2rem;">
        <div style="display:flex; align-items:flex-start; gap:0.75rem;">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E01A4F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; margin-top:2px;"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
          <span style="font-size:0.9rem; color:#333; line-height:1.5;">Técnicas certificadas de maquillaje profesional</span>
        </div>
        <div style="display:flex; align-items:flex-start; gap:0.75rem;">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E01A4F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; margin-top:2px;"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
          <span style="font-size:0.9rem; color:#333; line-height:1.5;">Productos de alta gama: MAC, Charlotte Tilbury, NYX</span>
        </div>
        <div style="display:flex; align-items:flex-start; gap:0.75rem;">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E01A4F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; margin-top:2px;"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
          <span style="font-size:0.9rem; color:#333; line-height:1.5;">Servicio a domicilio en Monterrey y área metropolitana</span>
        </div>
        <div style="display:flex; align-items:flex-start; gap:0.75rem;">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E01A4F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; margin-top:2px;"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
          <span style="font-size:0.9rem; color:#333; line-height:1.5;">Maquillaje duradero y fotogénico, garantizado</span>
        </div>
      </div>
      <a href="https://wa.me/528137459614" target="_blank" rel="noopener"
        style="display:inline-flex; align-items:center; gap:8px; background:#1A1A1A; color:white; text-decoration:none; padding:0 28px; border-radius:9999px; font-size:0.95rem; font-weight:700; height:50px; transition:background 0.2s;"
        onmouseover="this.style.background='#333'" onmouseout="this.style.background='#1A1A1A'">
        <!-- message-circle lucide -->
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
        Chatear por WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 460px 1fr;
    gap: 4rem;
    align-items: center;
  }
  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
