---
import { Image } from 'astro:assets';
import bookingImg from '../assets/images/generated-1775188098482.png';
---

<section id="contacto" class="bg-bg py-20 px-12">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-[260px_1fr] gap-10 items-start max-[900px]:grid-cols-1">
      <!-- Left: text + photo -->
      <div class="flex flex-col gap-6">
        <div>
          <p class="text-[0.72rem] font-semibold tracking-[0.18em] text-light-pink m-0 mb-2 uppercase">AGENDA TU CITA</p>
          <h2 class="font-serif text-[1.6rem] font-bold text-dark m-0 mb-3 leading-[1.2]">Reserva en línea</h2>
          <p class="text-[0.85rem] text-text/44 leading-[1.7] m-0">Selecciona tu servicio y elige el horario que mejor te acomode.</p>
        </div>
        <div class="rounded-[1.25rem] overflow-hidden">
          <Image src={bookingImg} alt="Carolina maquillista Monterrey" class="w-full h-[200px] object-cover block" />
        </div>
      </div>
      <!-- Right: Cal.com embed -->
      <div class="rounded-[1.25rem] overflow-hidden border-[1.5px] border-[#F0E6EA] min-h-[600px] bg-[#FFF8FA]">
        <div class="w-full min-h-[600px]" id="my-cal-inline-peinado"></div>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var target = document.getElementById('my-cal-inline-peinado');
    var initialized = false;

    var iframePatcher = new MutationObserver(function(mutations) {
      mutations.forEach(function(mutation) {
        mutation.addedNodes.forEach(function(node) {
          if (node.nodeName === 'IFRAME') {
            node.setAttribute('loading', 'lazy');
            node.setAttribute('title', 'Reserva tu cita con Carolina');
            node.setAttribute('sandbox',
              'allow-scripts allow-same-origin allow-forms ' +
              'allow-popups allow-popups-to-escape-sandbox ' +
              'allow-top-navigation-by-user-activation');
            node.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
            iframePatcher.disconnect();
          }
        });
      });
    });
    iframePatcher.observe(target, { childList: true, subtree: true });

    function initCal() {
      if (initialized) return;
      initialized = true;
      Cal.ns.peinado("inline", {
        elementOrSelector: "#my-cal-inline-peinado",
        config: {"layout":"month_view","useSlotsViewOnSmallScreen":"true"},
        calLink: "francisco-javier-moreno-hinojosa-udolb9/peinado",
      });
      Cal.ns.peinado("ui", {"cssVarsPerTheme":{"light":{"cal-brand":"#E01A4F"}},"hideEventTypeDetails":false,"layout":"month_view"});
    }
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function(entries) {
        if (entries[0].isIntersecting) { io.disconnect(); initCal(); }
      }, { rootMargin: '300px' });
      io.observe(target);
    } else {
      initCal();
    }
  })();
</script>
