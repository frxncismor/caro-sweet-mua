---
import { Image } from 'astro:assets';
import bookingImg from '../assets/images/generated-1775188098482.png';
---

<section id="contacto" style="background:#FDFAFA; padding:5rem 3rem;">
  <div style="max-width:1280px; margin:0 auto;">
    <div class="booking-grid">
      <!-- Left: text + photo -->
      <div style="display:flex; flex-direction:column; gap:1.5rem;">
        <div>
          <p style="font-size:0.72rem; font-weight:600; letter-spacing:0.18em; color:#E8B4B8; margin:0 0 0.5rem; text-transform:uppercase;">AGENDA TU CITA</p>
          <h2 style="font-family:'Playfair Display',serif; font-size:1.6rem; font-weight:700; color:#1A1A1A; margin:0 0 0.75rem; line-height:1.2;">Reserva en línea</h2>
          <p style="font-size:0.85rem; color:rgba(51,51,51,0.44); line-height:1.7; margin:0;">Selecciona tu servicio y elige el horario que mejor te acomode.</p>
        </div>
        <div style="border-radius:1.25rem; overflow:hidden;">
          <Image src={bookingImg} alt="Carolina maquillista Monterrey" style="width:100%; height:200px; object-fit:cover; display:block;" />
        </div>
      </div>
      <!-- Right: Cal.com embed -->
      <div style="border-radius:1.25rem; overflow:hidden; border:1.5px solid #F0E6EA; min-height:600px; background:#FFF8FA;">
        <!-- Cal inline embed — lazy loaded via IntersectionObserver -->
        <div style="width:100%; min-height:600px;" id="my-cal-inline-peinado"></div>
        <!-- Cal inline embed ends -->
      </div>
    </div>
  </div>
</section>

<style>
  .booking-grid {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  @media (max-width: 900px) {
    .booking-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  (function() {
    var target = document.getElementById('my-cal-inline-peinado');
    var initialized = false;

    // Patch iframe security attrs as soon as Cal injects it
    var iframePatcher = new MutationObserver(function(mutations) {
      mutations.forEach(function(mutation) {
        mutation.addedNodes.forEach(function(node) {
          if (node.nodeName === 'IFRAME') {
            node.setAttribute('loading', 'lazy');
            node.setAttribute('title', 'Reserva tu cita con Carolina');
            node.setAttribute('sandbox',
              'allow-scripts allow-same-origin allow-forms ' +
              'allow-popups allow-popups-to-escape-sandbox ' +
              'allow-top-navigation-by-user-activation');
            node.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
            iframePatcher.disconnect();
          }
        });
      });
    });
    iframePatcher.observe(target, { childList: true, subtree: true });

    function initCal() {
      if (initialized) return;
      initialized = true;
      Cal.ns.peinado("inline", {
        elementOrSelector: "#my-cal-inline-peinado",
        config: {"layout":"month_view","useSlotsViewOnSmallScreen":"true"},
        calLink: "francisco-javier-moreno-hinojosa-udolb9/peinado",
      });
      Cal.ns.peinado("ui", {"cssVarsPerTheme":{"light":{"cal-brand":"#E01A4F"}},"hideEventTypeDetails":false,"layout":"month_view"});
    }
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function(entries) {
        if (entries[0].isIntersecting) { io.disconnect(); initCal(); }
      }, { rootMargin: '300px' });
      io.observe(target);
    } else {
      initCal();
    }
  })();
</script>
