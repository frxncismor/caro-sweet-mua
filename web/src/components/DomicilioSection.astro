---
---

<section class="bg-dark py-20 px-12 reveal" aria-label="Servicio a domicilio">
  <div class="max-w-7xl mx-auto grid grid-cols-[1fr_380px] gap-16 items-center max-[900px]:grid-cols-1">
    <!-- Left -->
    <div>
      <p class="text-[0.72rem] font-semibold tracking-[0.18em] text-light-pink m-0 mb-4 uppercase">SERVICIO A DOMICILIO</p>
      <h2 class="font-serif text-[clamp(2rem,3.5vw,2.8rem)] font-bold text-white leading-[1.2] m-0 mb-5">
        ¡Llegamos a ti!
      </h2>
      <p class="text-[0.95rem] text-white/65 leading-[1.8] m-0 mb-8">
        No tienes que preocuparte por desplazarte. Carolina lleva todo el equipo y los productos de alta calidad directamente a tu puerta. Tú relájate, nosotras nos encargamos de todo.
      </p>
      <a href="#contacto" rel="noopener"
        class="inline-flex items-center gap-2 bg-primary text-white no-underline px-7 rounded-full text-[0.95rem] font-bold h-[50px] transition-colors duration-200 hover:bg-[#c01543]">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
        Agendar a domicilio
      </a>
    </div>
    <!-- Right: feature cards -->
    <div class="flex flex-col gap-5">
      <div class="bg-white/6 border border-white/10 rounded-2xl p-6 flex items-start gap-4">
        <div class="w-11 h-11 rounded-xl flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#E01A4F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
        </div>
        <div>
          <h4 class="text-white font-semibold m-0 mb-[0.3rem] text-[0.95rem]">Equipo y productos incluidos</h4>
          <p class="text-white/50 text-[0.82rem] m-0 leading-[1.5]">Todo lo necesario en tu doorstep</p>
        </div>
      </div>
      <div class="bg-white/6 border border-white/10 rounded-2xl p-6 flex items-start gap-4">
        <div class="w-11 h-11 rounded-xl flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#E01A4F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="10" x2="14" y1="2" y2="2"/><line x1="12" x2="15" y1="14" y2="11"/><circle cx="12" cy="14" r="8"/></svg>
        </div>
        <div>
          <h4 class="text-white font-semibold m-0 mb-[0.3rem] text-[0.95rem]">Puntualidad garantizada</h4>
          <p class="text-white/50 text-[0.82rem] m-0 leading-[1.5]">Llegamos a tiempo, siempre</p>
        </div>
      </div>
      <div class="bg-white/6 border border-white/10 rounded-2xl p-6 flex items-start gap-4">
        <div class="w-11 h-11 rounded-xl flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#E01A4F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <div>
          <h4 class="text-white font-semibold m-0 mb-[0.3rem] text-[0.95rem]">Monterrey y área metropolitana</h4>
          <p class="text-white/50 text-[0.82rem] m-0 leading-[1.5]">A domicilio donde tú estés</p>
        </div>
      </div>
    </div>
  </div>
</section>
