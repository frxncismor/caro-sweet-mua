---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
---

<footer class="bg-[#F5F5F5] border-t border-[#D9D9D9] pt-20 pb-10">
  <div class="container mx-auto px-6 flex flex-col items-center gap-10">
    <!-- Logo -->
    <Image src={logo} alt="CB MUA" width={100} height={100} class="object-contain" loading="lazy" />

    <!-- Social links -->
    <div class="flex flex-wrap justify-center gap-10">
      <!-- Instagram -->
      <a href="https://www.instagram.com/carolinab.mua/" target="_blank" rel="noopener" title="Seguir a CB MUA en Instagram"
        class="flex items-center gap-2 text-[#6E6E6E] hover:text-[#1C1C1C] transition-all hover:scale-110 no-underline text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
        Instagram
      </a>

      <!-- WhatsApp -->
      <a href="https://wa.me/528137459614?text=%C2%A1Hola%20Caro!%20%E2%9C%A8%20Vi%20tu%20trabajo%20y%20quiero%20lucir%20incre%C3%ADble%20en%20mi%20pr%C3%B3ximo%20evento.%20%C2%BFTienes%20disponibilidad%20para%20una%20cita%3F" target="_blank" rel="noopener" title="Contactar a CB MUA por WhatsApp"
        class="flex items-center gap-2 text-[#6E6E6E] hover:text-[#1C1C1C] transition-all hover:scale-110 no-underline text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
        WhatsApp
      </a>
    </div>

    <!-- Divider -->
    <div class="w-full h-px bg-[#D9D9D9]"></div>

    <!-- Bottom -->
    <div class="flex items-center justify-between flex-wrap gap-4 text-[#6E6E6E] text-xs w-full">
      <span>© 2025 CB MUA. Maquillaje y peinado profesional en Monterrey.</span>
      <a href="https://www.frxncismor.dev/" target="_blank" rel="noopener" class="text-[#6E6E6E] hover:text-[#1C1C1C] no-underline transition-colors">Made by @frxncismor</a>
      <div class="flex items-center gap-4">
        <a href="/privacy" class="text-[#6E6E6E] hover:text-[#1C1C1C] no-underline transition-colors">Aviso de Privacidad</a>
        <a href="/terms" class="text-[#6E6E6E] hover:text-[#1C1C1C] no-underline transition-colors">Términos de Servicio</a>
      </div>
    </div>
  </div>
</footer>
