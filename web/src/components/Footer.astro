---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
---

<footer class="bg-[#FDF6F0] pt-20 pb-10">
  <div class="container mx-auto px-6 flex flex-col items-center gap-10">
    <!-- Logo -->
    <Image src={logo} alt="Caro Sweet MUA" width={140} height={48} class="object-contain" loading="lazy" />

    <!-- Social links -->
    <div class="flex flex-wrap justify-center gap-10">
      <!-- Instagram -->
      <a href="https://instagram.com/caro_sweet.mua" target="_blank" rel="noopener" title="Seguir a Caro Sweet MUA en Instagram"
        class="flex items-center gap-2 text-stone-500 hover:text-primary-container transition-all hover:scale-110 no-underline text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
        Instagram
      </a>

      <!-- WhatsApp -->
      <a href="https://wa.me/528137459614?text=%C2%A1Hola%20Caro!%20%E2%9C%A8%20Vi%20tu%20trabajo%20y%20quiero%20lucir%20incre%C3%ADble%20en%20mi%20pr%C3%B3ximo%20evento.%20%C2%BFTienes%20disponibilidad%20para%20una%20cita%3F" target="_blank" rel="noopener" title="Contactar a Caro Sweet MUA por WhatsApp"
        class="flex items-center gap-2 text-stone-500 hover:text-primary-container transition-all hover:scale-110 no-underline text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
        WhatsApp
      </a>
    </div>

    <!-- Divider -->
    <div class="w-full h-px bg-gradient-to-r from-transparent via-primary-container/20 to-transparent"></div>

    <!-- Bottom -->
    <div class="flex items-center justify-between flex-wrap gap-4 text-stone-400 text-xs w-full">
      <span>© 2025 Caro Sweet MUA. Haz que cada ocasión sea inolvidable.</span>
      <div class="flex items-center gap-4">
        <a href="/privacy" class="text-stone-400 hover:text-primary-container no-underline transition-colors">Aviso de Privacidad</a>
        <a href="/terms" class="text-stone-400 hover:text-primary-container no-underline transition-colors">Términos de Servicio</a>
      </div>
    </div>
  </div>
</footer>
