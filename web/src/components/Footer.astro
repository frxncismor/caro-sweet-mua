---
import { Image } from 'astro:assets';
import logoWhite from '../assets/images/logo_white.png';
---

<footer class="bg-dark px-20 py-10 overflow-hidden max-[900px]:px-5 max-[640px]:px-5">
  <div class="flex items-start justify-between gap-8 max-w-7xl mx-auto max-[900px]:flex-col max-[900px]:items-center">
    <!-- Left -->
    <div class="flex flex-col gap-3 flex-1 max-[900px]:items-center max-[900px]:text-center">
      <Image src={logoWhite} alt="Caro Sweet Mua" width={150} height={48} class="object-contain opacity-90 max-[900px]:block max-[900px]:mx-auto" loading="lazy" />
      <p class="text-white/38 text-[14px] m-0">Hacemos brillar tu belleza natural con pasión y profesionalismo.</p>
      <div class="flex items-center gap-3 flex-wrap max-[900px]:justify-center">
        <a href="https://instagram.com/caro_sweet.mua" target="_blank" rel="noopener"
          class="inline-flex items-center gap-2 bg-white/6 text-light-pink no-underline px-4 rounded-[18px] text-[13px] h-9 border border-white/8 transition-colors duration-200 hover:bg-white/12">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          @caro_sweet.mua
        </a>
        <a href="https://wa.me/528137459614?text=%C2%A1Hola%20Caro!%20%E2%9C%A8%20Vi%20tu%20trabajo%20y%20quiero%20lucir%20incre%C3%ADble%20en%20mi%20pr%C3%B3ximo%20evento.%20%C2%BFTienes%20disponibilidad%20para%20una%20cita%3F" target="_blank" rel="noopener"
          class="inline-flex items-center gap-2 bg-wa-green/8 text-wa-green no-underline px-4 rounded-[18px] text-[13px] h-9 transition-colors duration-200 hover:bg-wa-green/15">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
          WhatsApp
        </a>
      </div>
    </div>
    <!-- Right -->
    <div class="flex flex-col items-end gap-3 shrink-0 max-[900px]:items-center max-[640px]:items-center">
      <p class="text-light-pink text-[12px] font-bold tracking-[1px] m-0 uppercase">Horario</p>
      <p class="text-white/38 text-[13px] m-0">Lun – Sáb: 9:00 AM – 8:00 PM</p>
      <p class="text-white/38 text-[13px] m-0">Dom: Solo con cita previa</p>
      <div class="flex items-center gap-[6px]">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#E8B4B8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        <span class="text-white/38 text-[13px]">Monterrey y área metropolitana</span>
      </div>
    </div>
  </div>
  <!-- Bottom bar -->
  <div class="max-w-7xl mx-auto mt-6 pt-5 border-t border-white/8 flex items-center justify-between flex-wrap gap-2 text-[11px] text-white/22 max-[900px]:flex-col max-[900px]:items-center max-[900px]:gap-1 max-[900px]:text-center">
    <span>© 2025 Caro Sweet Mua</span>
    <span>Hecho por <a href="https://www.frxncismor.dev/" target="_blank" rel="noopener" class="text-white/45 no-underline transition-colors duration-200 hover:text-light-pink">@frxncismor</a></span>
  </div>
</footer>
