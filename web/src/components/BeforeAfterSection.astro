---
import { Image } from 'astro:assets';
import after1 from '../assets/images/generated-1775187114555.png';
import before1 from '../assets/images/generated-1775187132922.png';
import after2 from '../assets/images/generated-1775187154381.png';
import before2 from '../assets/images/generated-1775187172050.png';
---

<section style="background:#FFF0F5; padding:5rem 3rem;">
  <div style="max-width:1280px; margin:0 auto;">
    <div style="text-align:center; margin-bottom:3rem;">
      <p style="font-size:0.72rem; font-weight:600; letter-spacing:0.18em; color:#E8B4B8; margin:0 0 0.75rem; text-transform:uppercase;">TRANSFORMACIONES REALES</p>
      <h2 style="font-family:'Playfair Display',serif; font-size:clamp(1.8rem,3vw,2.5rem); font-weight:700; color:#1A1A1A; margin:0;">
        La transformación habla por sí sola
      </h2>
    </div>
    <div class="ba-grid">
      <!-- Slider 1 -->
      <div>
        <div class="ba-container" id="ba1" style="height:420px;">
          <div class="ba-before" style="position:absolute; inset:0;">
            <Image src={before1} alt="Antes maquillaje" style="width:100%; height:100%; object-fit:cover;" />
          </div>
          <div class="ba-after" id="ba1-after" style="clip-path:inset(0 50% 0 0);">
            <Image src={after1} alt="Después maquillaje" style="width:100%; height:100%; object-fit:cover;" />
          </div>
          <div class="ba-handle" id="ba1-handle" style="left:50%;"><div class="ba-circle">↔</div></div>
        </div>
        <div style="display:flex; justify-content:space-between; margin-top:0.75rem;">
          <span class="ba-label ba-label--antes">Antes</span>
          <span class="ba-label ba-label--despues">Después ✦</span>
        </div>
      </div>
      <!-- Slider 2 -->
      <div>
        <div class="ba-container" id="ba2" style="height:420px;">
          <div class="ba-before" style="position:absolute; inset:0;">
            <Image src={before2} alt="Antes maquillaje" style="width:100%; height:100%; object-fit:cover;" />
          </div>
          <div class="ba-after" id="ba2-after" style="clip-path:inset(0 50% 0 0);">
            <Image src={after2} alt="Después maquillaje" style="width:100%; height:100%; object-fit:cover;" />
          </div>
          <div class="ba-handle" id="ba2-handle" style="left:50%;"><div class="ba-circle">↔</div></div>
        </div>
        <div style="display:flex; justify-content:space-between; margin-top:0.75rem;">
          <span class="ba-label ba-label--antes">Antes</span>
          <span class="ba-label ba-label--despues">Después ✦</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .ba-container {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    cursor: ew-resize;
    user-select: none;
  }
  .ba-after {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .ba-after img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ba-before img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ba-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
    background: white;
    transform: translateX(-50%);
    pointer-events: none;
  }
  .ba-circle {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: white;
    box-shadow: 0 0 8px rgba(0,0,0,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #E01A4F;
    font-size: 15px;
    font-weight: bold;
  }
  .ba-label {
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
  }
  .ba-label--antes {
    background: #f0f0f0;
    color: #444;
  }
  .ba-label--despues {
    background: #E01A4F;
    color: white;
  }

  @media (max-width: 640px) {
    .ba-container { height: 260px !important; }
  }
</style>

<style>
  .ba-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  @media (max-width: 900px) {
    .ba-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function initSlider(containerId, afterId, handleId) {
    const container = document.getElementById(containerId);
    const afterEl   = document.getElementById(afterId);
    const handleEl  = document.getElementById(handleId);
    if (!container || !afterEl || !handleEl) return;

    afterEl.style.clipPath = 'inset(0 50% 0 0)';
    handleEl.style.left = '50%';

    function moveTo(clientX) {
      const rect = container.getBoundingClientRect();
      const pct  = Math.min(100, Math.max(0, (clientX - rect.left) / rect.width * 100));
      afterEl.style.clipPath = `inset(0 ${100 - pct}% 0 0)`;
      handleEl.style.left = pct + '%';
    }

    container.addEventListener('mousedown', e => {
      e.preventDefault();
      moveTo(e.clientX);
      function onMove(e) { moveTo(e.clientX); }
      function onUp()   { document.removeEventListener('mousemove', onMove); document.removeEventListener('mouseup', onUp); }
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup',   onUp);
    });

    container.addEventListener('touchstart', e => {
      e.preventDefault();
      moveTo(e.touches[0].clientX);
      function onMove(e) { moveTo(e.touches[0].clientX); }
      function onEnd()   { document.removeEventListener('touchmove', onMove); document.removeEventListener('touchend', onEnd); }
      document.addEventListener('touchmove', onMove, { passive: false });
      document.addEventListener('touchend',  onEnd);
    }, { passive: false });
  }
  initSlider('ba1', 'ba1-after', 'ba1-handle');
  initSlider('ba2', 'ba2-after', 'ba2-handle');
</script>
