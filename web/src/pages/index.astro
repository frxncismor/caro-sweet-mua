---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import HeroSection from '../components/HeroSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import AboutSection from '../components/AboutSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import GallerySection from '../components/GallerySection.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Caro Sweet MUA | Maquillaje y Peinado en Monterrey"
  description="Especialista en realzar tu belleza natural con un toque editorial. Maquillaje y peinado profesional en Monterrey, N.L."
  canonicalUrl="https://caro-sweet-mua.vercel.app/"
  ogImage="https://caro-sweet-mua.vercel.app/images/og-cover.jpg"
>
  <Navbar />
  <main id="main-content">
    <HeroSection />
    <ServicesSection />
    <AboutSection />
    <TestimonialsSection />
    <GallerySection />
    <CtaBanner />
    <Footer />
  </main>
</BaseLayout>
