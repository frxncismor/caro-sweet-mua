---
import '../styles/global.css';
import { Image } from 'astro:assets';

import logo        from '../assets/images/logo.png';
import logoWhite   from '../assets/images/logo_white.png';
import heroImg     from '../assets/images/generated-1775198929226.png';
import card1Img    from '../assets/images/generated-1775187017791.png';
import card2Img    from '../assets/images/generated-1775187046111.png';
import card3Img    from '../assets/images/generated-1775187063488.png';
import caroAbout   from '../assets/images/caro_3.jpg';
import conv1       from '../assets/images/conversation (1).png';
import conv2       from '../assets/images/conversation (2).png';
import conv3       from '../assets/images/conversation (3).png';
import after1     from '../assets/images/generated-1775187114555.png';
import before1      from '../assets/images/generated-1775187132922.png';
import after2     from '../assets/images/generated-1775187154381.png';
import before2      from '../assets/images/generated-1775187172050.png';
import bookingImg  from '../assets/images/generated-1775188098482.png';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Caro Sweet Mua — Maquillista profesional en Monterrey, NL. Maquillaje a domicilio para novias, quinceañeras y looks del día a día. Agenda tu cita hoy." />
  <title>Caro Sweet Mua — Maquillista Profesional en Monterrey</title>
  <link rel="icon" href="/images/logo.png" type="image/png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <!-- Cal element-click embed -->
  <script type="text/javascript">
    (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, ["initNamespace", namespace]);} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
    Cal("init", "peinado", {origin:"https://app.cal.com"});
    Cal.ns.peinado("ui", {"hideEventTypeDetails":false,"layout":"month_view"});
  </script>
</head>
<body style="background-color:#FDFAFA; font-family:'Inter',sans-serif; color:#333333; margin:0; padding:0;">

<!-- ═══════════════════════════════════════════
     NAVBAR
═══════════════════════════════════════════ -->
<nav style="position:sticky; top:0; z-index:100; background:white; border-bottom:1px solid #F0E6EA; box-shadow:0 1px 8px rgba(0,0,0,0.06);">
  <div style="max-width:1280px; margin:0 auto; padding:0 3rem; display:flex; align-items:center; justify-content:space-between; height:72px;">
    <a href="/" style="display:flex; align-items:center; text-decoration:none;">
      <Image src={logo} alt="Caro Sweet Mua" width={130} height={44} style="object-fit:contain;" loading="eager" />
    </a>
    <div style="display:flex; align-items:center; gap:2rem;" class="nav-links-desktop">
      <a href="#servicios" style="text-decoration:none; color:rgba(51,51,51,0.69); font-size:0.9rem; font-weight:500;" onmouseover="this.style.color='#E01A4F'" onmouseout="this.style.color='rgba(51,51,51,0.69)'">Servicios</a>
      <a href="#galeria" style="text-decoration:none; color:rgba(51,51,51,0.69); font-size:0.9rem; font-weight:500;" onmouseover="this.style.color='#E01A4F'" onmouseout="this.style.color='rgba(51,51,51,0.69)'">Galería</a>
      <a href="#testimonios" style="text-decoration:none; color:rgba(51,51,51,0.69); font-size:0.9rem; font-weight:500;" onmouseover="this.style.color='#E01A4F'" onmouseout="this.style.color='rgba(51,51,51,0.69)'">Testimonios</a>
      <a href="#contacto" style="text-decoration:none; color:rgba(51,51,51,0.69); font-size:0.9rem; font-weight:500;" onmouseover="this.style.color='#E01A4F'" onmouseout="this.style.color='rgba(51,51,51,0.69)'">Contacto</a>
    </div>
    <a href="#contacto"
      style="display:flex; align-items:center; gap:8px; background:#E01A4F; color:white; text-decoration:none; padding:0 24px; border-radius:21px; font-size:0.875rem; font-weight:700; height:42px; white-space:nowrap; transition:background 0.2s;"
      onmouseover="this.style.background='#c01543'" onmouseout="this.style.background='#E01A4F'"
      class="nav-cta-btn">
      <!-- message-circle lucide -->
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
      Reservar cita
    </a>
    <!-- Hamburger button -->
    <button id="hamburger-btn" class="hamburger-btn" aria-label="Menú" aria-expanded="false">
      <span class="ham-bar"></span>
      <span class="ham-bar"></span>
      <span class="ham-bar"></span>
    </button>
  </div>
</nav>

<!-- Mobile menu -->
<div id="mobile-menu" class="mobile-menu" aria-hidden="true">
  <a href="#servicios" class="mobile-nav-link">Servicios</a>
  <a href="#galeria" class="mobile-nav-link">Galería</a>
  <a href="#testimonios" class="mobile-nav-link">Testimonios</a>
  <a href="#contacto" class="mobile-nav-link">Contacto</a>
  <a href="#contacto" style="display:flex; align-items:center; justify-content:center; gap:8px; background:#E01A4F; color:white; text-decoration:none; padding:0.8rem; border-radius:21px; font-size:0.9rem; font-weight:700; margin-top:0.5rem;">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
    Reservar cita
  </a>
</div>

<!-- ═══════════════════════════════════════════
     HERO
═══════════════════════════════════════════ -->
<section style="display:grid; grid-template-columns:60% 40%; height:640px; background:#FFF0F5;" class="hero-section">
  <!-- Left: photo -->
  <div style="position:relative; overflow:hidden; height:640px;">
    <Image src={heroImg} alt="Maquillaje profesional Monterrey" style="width:100%; height:100%; object-fit:cover; display:block;" loading="eager" />
    <!-- Social badge – absolute bottom-left -->
    <div style="position:absolute; bottom:28px; left:24px; background:white; border-radius:18px; padding:0 16px; display:flex; align-items:center; gap:8px; height:36px; box-shadow:0 4px 16px rgba(0,0,0,0.12); font-size:13px; font-weight:600; color:#1A1A1A;">
      <!-- star lucide -->
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#F5A623" stroke="#F5A623" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      4.9 · +200 clientas felices
    </div>
  </div>

  <!-- Right: content -->
  <div style="display:flex; flex-direction:column; justify-content:center; padding:56px 48px 56px 56px; gap:20px; background:#FFF0F5;">
    <p style="font-size:0.72rem; font-weight:600; letter-spacing:0.18em; color:#E8B4B8; margin:0; text-transform:uppercase;">MAQUILLISTA PROFESIONAL · MONTERREY, NL</p>
    <h1 style="font-family:'Playfair Display',Georgia,serif; font-size:clamp(2.2rem,3.5vw,3rem); font-weight:700; color:#1A1A1A; line-height:1.15; margin:0;">
      Luce increíble<br/>en cada ocasión
    </h1>
    <p style="font-family:'Playfair Display',Georgia,serif; font-style:italic; font-size:1rem; color:#C0737A; margin:0; line-height:1.5;">
      "Hacemos brillar tu belleza natural con pasión y profesionalismo."
    </p>
    <p style="font-size:0.9rem; color:rgba(51,51,51,0.65); line-height:1.7; margin:0;">
      Maquillaje, secados y paquetes especiales para novias, quinceañeras y looks del día a día. A domicilio en Monterrey.
    </p>
    <a href="#contacto"
      style="display:flex; align-items:center; justify-content:center; background:#E01A4F; color:white; text-decoration:none; height:54px; border-radius:27px; font-size:1rem; font-weight:700; letter-spacing:0.02em; box-shadow:0 8px 24px rgba(224,26,79,0.25); transition:background 0.2s;"
      onmouseover="this.style.background='#c01543'" onmouseout="this.style.background='#E01A4F'">
      Agenda tu cita →
    </a>
    <!-- Trust row -->
    <div style="display:flex; gap:1.25rem; flex-wrap:wrap;">
      <div style="display:flex; align-items:center; gap:6px; font-size:0.82rem; color:#555;">
        <!-- circle-check lucide -->
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E01A4F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
        A domicilio
      </div>
      <div style="display:flex; align-items:center; gap:6px; font-size:0.82rem; color:#555;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E01A4F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
        Productos premium
      </div>
      <div style="display:flex; align-items:center; gap:6px; font-size:0.82rem; color:#555;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E01A4F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
        3+ años de experiencia
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     SOCIAL PROOF STRIP
═══════════════════════════════════════════ -->
<section class="social-proof-strip" style="background:#FCF0F3; border-top:1px solid #F0DCE2; border-bottom:1px solid #F0DCE2; padding:0 3rem; height:88px; display:flex; align-items:center;">
  <div class="social-proof-grid" style="max-width:1280px; margin:0 auto; width:100%; display:flex; text-align:center; justify-content: space-between;">
    <div>
      <p style="font-family:'Playfair Display',serif; font-size:1.75rem; font-weight:700; color:#E01A4F; margin:0;">+200</p>
      <p style="font-size:0.82rem; color:#555; margin:0.15rem 0 0; line-height:1.4;">Clientas atendidas</p>
    </div>
    <div>
      <p style="font-family:'Playfair Display',serif; font-size:1.75rem; font-weight:700; color:#E01A4F; margin:0;">5.0★</p>
      <p style="font-size:0.82rem; color:#555; margin:0.15rem 0 0; line-height:1.4;">Calificación en Google</p>
    </div>
    <div>
      <p style="font-family:'Playfair Display',serif; font-size:1.75rem; font-weight:700; color:#E01A4F; margin:0;">3+</p>
      <p style="font-size:0.82rem; color:#555; margin:0.15rem 0 0; line-height:1.4;">Años de experiencia</p>
    </div>
    <div>
      <p style="font-family:'Playfair Display',serif; font-size:1.75rem; font-weight:700; color:#E01A4F; margin:0;">MTY, NL</p>
      <p style="font-size:0.82rem; color:#555; margin:0.15rem 0 0; line-height:1.4;">Servicio a domicilio</p>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     SERVICIOS
═══════════════════════════════════════════ -->
<section id="servicios" style="background:#FDFAFA; padding:5rem 3rem;">
  <div style="max-width:1280px; margin:0 auto;">
    <div style="text-align:center; margin-bottom:3rem;">
      <p style="font-size:0.72rem; font-weight:600; letter-spacing:0.18em; color:#E8B4B8; margin:0 0 0.75rem; text-transform:uppercase;">NUESTROS SERVICIOS</p>
      <h2 style="font-family:'Playfair Display',serif; font-size:clamp(1.8rem,3vw,2.5rem); font-weight:700; color:#1A1A1A; margin:0;">
        Todo lo que necesitas para lucir espectacular
      </h2>
    </div>
    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem;">

      <!-- Card 1 -->
      <div style="border:1.5px solid #F0E6EA; border-radius:1rem; overflow:hidden; display:flex; flex-direction:column; transition:box-shadow 0.2s;" onmouseover="this.style.boxShadow='0 8px 30px rgba(224,26,79,0.12)'" onmouseout="this.style.boxShadow='none'">
        <div style="height:260px; overflow:hidden;">
          <Image src={card1Img} alt="Maquillaje profesional" style="width:100%; height:100%; object-fit:cover; display:block; transition:transform 0.3s;" onmouseover="this.style.transform='scale(1.04)'" onmouseout="this.style.transform='scale(1)'" />
        </div>
        <div style="padding:1.5rem; display:flex; flex-direction:column; gap:0.75rem; flex:1;">
          <div style="display:inline-flex; align-items:center; background:#FCF0F3; border-radius:9999px; padding:0.2rem 0.75rem; width:fit-content;">
            <span style="font-size:0.7rem; font-weight:600; color:#C0737A; letter-spacing:0.06em; text-transform:uppercase;">Maquillaje</span>
          </div>
          <h3 style="font-family:'Playfair Display',serif; font-size:1.25rem; font-weight:700; color:#1A1A1A; margin:0;">Maquillaje Profesional</h3>
          <p style="font-size:0.9rem; color:#555; margin:0; line-height:1.6;">Social, novia, artístico, quinceañera y natural. Un look creado especialmente para ti.</p>
          <div style="margin-top:auto; padding-top:1rem; border-top:1px solid #F0E6EA;">
            <span style="font-size:0.78rem; color:#999;">Desde</span>
            <p style="font-family:'Playfair Display',serif; font-size:1.75rem; font-weight:700; color:#E01A4F; margin:0;">$280</p>
          </div>
          <button type="button" data-cal-link="francisco-javier-moreno-hinojosa-udolb9/peinado" data-cal-namespace="peinado" data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}' style="display:block; width:100%; background:#E01A4F; color:white; border:none; padding:0.65rem; border-radius:9999px; font-size:0.875rem; font-weight:600; text-align:center; transition:background 0.2s; cursor:pointer;" onmouseover="this.style.background='#c01543'" onmouseout="this.style.background='#E01A4F'">
            Reservar
          </button>
        </div>
      </div>

      <!-- Card 2 -->
      <div style="border:1.5px solid #F0E6EA; border-radius:1rem; overflow:hidden; display:flex; flex-direction:column; transition:box-shadow 0.2s;" onmouseover="this.style.boxShadow='0 8px 30px rgba(224,26,79,0.12)'" onmouseout="this.style.boxShadow='none'">
        <div style="height:260px; overflow:hidden;">
          <Image src={card2Img} alt="Secados y peinados" style="width:100%; height:100%; object-fit:cover; display:block; transition:transform 0.3s;" onmouseover="this.style.transform='scale(1.04)'" onmouseout="this.style.transform='scale(1)'" />
        </div>
        <div style="padding:1.5rem; display:flex; flex-direction:column; gap:0.75rem; flex:1;">
          <div style="display:inline-flex; align-items:center; background:#F0F0FF; border-radius:9999px; padding:0.2rem 0.75rem; width:fit-content;">
            <span style="font-size:0.7rem; font-weight:600; color:#6060C0; letter-spacing:0.06em; text-transform:uppercase;">Peinado</span>
          </div>
          <h3 style="font-family:'Playfair Display',serif; font-size:1.25rem; font-weight:700; color:#1A1A1A; margin:0;">Secados & Peinados</h3>
          <p style="font-size:0.9rem; color:#555; margin:0; line-height:1.6;">Clásico, ondas, volumen máximo y definición de rizos. Tu cabello, perfecto.</p>
          <div style="margin-top:auto; padding-top:1rem; border-top:1px solid #F0E6EA;">
            <span style="font-size:0.78rem; color:#999;">Desde</span>
            <p style="font-family:'Playfair Display',serif; font-size:1.75rem; font-weight:700; color:#E01A4F; margin:0;">$200</p>
          </div>
          <button type="button" data-cal-link="francisco-javier-moreno-hinojosa-udolb9/peinado" data-cal-namespace="peinado" data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}' style="display:block; width:100%; background:#E01A4F; color:white; border:none; padding:0.65rem; border-radius:9999px; font-size:0.875rem; font-weight:600; text-align:center; transition:background 0.2s; cursor:pointer;" onmouseover="this.style.background='#c01543'" onmouseout="this.style.background='#E01A4F'">
            Reservar
          </button>
        </div>
      </div>

      <!-- Card 3 – dark -->
      <div style="background:#333333; border-radius:1rem; overflow:hidden; display:flex; flex-direction:column;">
        <div style="height:260px; overflow:hidden; position:relative;">
          <Image src={card3Img} alt="Paquetes especiales" style="width:100%; height:100%; object-fit:cover; display:block;" />
          <div style="position:absolute; top:1rem; right:1rem; background:#E01A4F; color:white; font-size:0.65rem; font-weight:700; padding:0.3rem 0.7rem; border-radius:9999px; letter-spacing:0.08em;">MEJOR VALOR</div>
        </div>
        <div style="padding:1.5rem; display:flex; flex-direction:column; gap:0.75rem; flex:1;">
          <div style="display:inline-flex; align-items:center; background:#E01A4F; border-radius:9999px; padding:0.2rem 0.75rem; width:fit-content;">
            <span style="font-size:0.7rem; font-weight:600; color:white; letter-spacing:0.06em; text-transform:uppercase;">Paquete</span>
          </div>
          <h3 style="font-family:'Playfair Display',serif; font-size:1.25rem; font-weight:700; color:white; margin:0;">Paquetes Especiales</h3>
          <p style="font-size:0.9rem; color:rgba(255,255,255,0.7); margin:0; line-height:1.6;">Maquillaje + peinado completo para bodas, quinceañeras y eventos especiales. Todo incluido.</p>
          <div style="margin-top:auto; padding-top:1rem; border-top:1px solid rgba(255,255,255,0.1);">
            <span style="font-size:0.78rem; color:rgba(255,255,255,0.5);">Desde</span>
            <p style="font-family:'Playfair Display',serif; font-size:1.75rem; font-weight:700; color:#E8B4B8; margin:0;">$480</p>
          </div>
          <button type="button" data-cal-link="francisco-javier-moreno-hinojosa-udolb9/peinado" data-cal-namespace="peinado" data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}' style="display:block; width:100%; background:#E01A4F; color:white; border:none; padding:0.65rem; border-radius:9999px; font-size:0.875rem; font-weight:600; text-align:center; transition:background 0.2s; cursor:pointer;" onmouseover="this.style.background='#c01543'" onmouseout="this.style.background='#E01A4F'">
            Reservar
          </button>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     ¡LLEGAMOS A TI!
═══════════════════════════════════════════ -->
<section style="background:#1A1A1A; padding:5rem 3rem;">
  <div style="max-width:1280px; margin:0 auto; display:grid; grid-template-columns:1fr 380px; gap:4rem; align-items:center;">
    <!-- Left -->
    <div>
      <p style="font-size:0.72rem; font-weight:600; letter-spacing:0.18em; color:#E8B4B8; margin:0 0 1rem; text-transform:uppercase;">SERVICIO A DOMICILIO</p>
      <h2 style="font-family:'Playfair Display',serif; font-size:clamp(2rem,3.5vw,2.8rem); font-weight:700; color:white; line-height:1.2; margin:0 0 1.25rem;">
        ¡Llegamos a ti!
      </h2>
      <p style="font-size:0.95rem; color:rgba(255,255,255,0.65); line-height:1.8; margin:0 0 2rem;">
        No tienes que preocuparte por desplazarte. Carolina lleva todo el equipo y los productos de alta calidad directamente a tu puerta. Tú relájate, nosotras nos encargamos de todo.
      </p>
      <a href="#contacto" rel="noopener"
        style="display:inline-flex; align-items:center; gap:8px; background:#E01A4F; color:white; text-decoration:none; padding:0 28px; border-radius:9999px; font-size:0.95rem; font-weight:700; height:50px; transition:background 0.2s;"
        onmouseover="this.style.background='#c01543'" onmouseout="this.style.background='#E01A4F'">
        <!-- calendar lucide -->
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
        Agendar a domicilio
      </a>
    </div>
    <!-- Right: feature cards -->
    <div style="display:flex; flex-direction:column; gap:1.25rem;">
      <div style="background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.1); border-radius:1rem; padding:1.5rem; display:flex; align-items:flex-start; gap:1rem;">
        <div style="width:44px; height:44px; border-radius:0.75rem; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
          <!-- package lucide -->
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#E01A4F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
        </div>
