---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import HeroSection from '../components/HeroSection.astro';
import SocialProofStrip from '../components/SocialProofStrip.astro';
import ServicesSection from '../components/ServicesSection.astro';
import DomicilioSection from '../components/DomicilioSection.astro';
import AboutSection from '../components/AboutSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import GallerySection from '../components/GallerySection.astro';
