---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import HeroSection from '../components/HeroSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import AboutSection from '../components/AboutSection.astro';
import GallerySection from '../components/GallerySection.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="CB MUA | Maquillaje y Peinado Profesional en Monterrey"
  description="Maquillaje y peinado profesional a domicilio en Monterrey, N.L. Looks naturales y elegantes para novias, quinceañeras y eventos sociales. Caro Beauty Mua."
  canonicalUrl="https://caro-sweet-mua.vercel.app/"
  ogImage="https://caro-sweet-mua.vercel.app/images/og-cover.jpg"
>
  <Navbar />
  <main id="main-content">
    <HeroSection />
    <ServicesSection />
    <AboutSection />
    <GallerySection />
    <CtaBanner />
    <Footer />
  </main>
</BaseLayout>
